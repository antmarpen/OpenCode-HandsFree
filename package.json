{
  "name": "opencode-handsfree",
  "version": "0.1.0",
  "description": "Hands-free voice for OpenCode Desktop: speech-to-text dictation, spoken replies and a conversation loop.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "voice",
    "dictation",
    "speech",
    "stt",
    "tts",
    "speech-to-text",
    "text-to-speech",
    "hands-free"
  ],
  "homepage": "https://github.com/antmarpen/opencode-handsfree#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antmarpen/opencode-handsfree.git"
  },
  "bugs": {
    "url": "https://github.com/antmarpen/opencode-handsfree/issues"
  },
  "author": "antmarpen (https://github.com/antmarpen)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "solid-js": "^1.9.20",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.17"
  }
}
